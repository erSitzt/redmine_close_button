<%= stylesheet_link_tag "redmine_close_button.css", :plugin => 'redmine_close_button' %>
<% close_label = l(:button_close) %>
<%= link_to(respond_to?(:sprite_icon) ? sprite_icon('checked', close_label) : close_label,
            'javascript:;',
            :class => 'icon icon-checked redmine-close-button',
            :id => 'redmine-close-button-template') %>
<%= javascript_include_tag "redmine_close_button.js", :plugin => 'redmine_close_button' %>
